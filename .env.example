# =============================================================================
# NeoBank - environment variables
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# This project is a PORTFOLIO DEMO. It is only ever meant to run against TEST
# and SANDBOX credentials - Stripe test mode and Plaid sandbox. No real money
# moves through it. Do not put live Stripe keys or Plaid production credentials
# in here.
#
# Every variable below is read somewhere in the code. Nothing is optional
# unless it says so.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Prisma needs BOTH of these - see the `datasource db` block in
# prisma/schema.prisma, which declares `url` and `directUrl`.
#
# Both live in the Supabase dashboard under
# Project Settings > Database > Connection string / Connection pooling.
# Both POOLER strings share a host of the shape
# `aws-0-<region>.pooler.supabase.com` and a username of the shape
# `postgres.<project-ref>`. Only the PORT tells them apart. Supabase's third
# option, "Direct connection", uses a different host
# (`db.<project-ref>.supabase.co`) and a plain `postgres` username - see the
# warning below before you reach for it.
#
# DATABASE_URL is the TRANSACTION pooler (port 6543). It is what the app uses at
# runtime: short-lived connections, one per serverless invocation.
# `?pgbouncer=true` is required - it tells Prisma to stop using prepared
# statements, which the pooler in transaction mode cannot handle.
#
# DIRECT_URL is the SESSION pooler (port 5432). Prisma Migrate uses it for DDL
# and advisory locks, which cannot run through a transaction-mode pooler.
# Without it, `prisma migrate` and `prisma db push` fail.
#
# ,---------------------------------------------------------------------------.
# | WARNING: DO NOT USE SUPABASE'S "DIRECT CONNECTION" STRING FOR             |
# | DIRECT_URL IF YOU DEPLOY ON VERCEL. Prisma's own docs tell you to, and    |
# | on a free-tier Supabase project it will break your build.                 |
# |                                                                           |
# | On the free tier, `db.<project-ref>.supabase.co` resolves to an IPv6      |
# | address ONLY. Vercel's build containers have no IPv6 egress, so           |
# | `prisma migrate deploy` cannot open a socket and dies with a connection   |
# | timeout / "Can't reach database server". It reads like a firewall rule,   |
# | a wrong password or a Supabase outage. It is none of those, and the       |
# | symptom points nowhere near the cause, which is what makes it expensive.  |
# |                                                                           |
# | The SESSION pooler is the fix: it is reachable over IPv4, and unlike the  |
# | transaction pooler it holds one dedicated connection for the length of    |
# | the session, which is exactly what Prisma Migrate needs for advisory      |
# | locks and DDL.                                                            |
# |                                                                           |
# | If you are NOT on Vercel or another IPv4-only serverless platform, and    |
# | your machine or CI has working IPv6, the direct connection is completely  |
# | fine for DIRECT_URL. The session pooler is a workaround for missing       |
# | IPv6 egress, not a Prisma requirement.                                    |
# `---------------------------------------------------------------------------'

# Runtime: TRANSACTION pooler, port 6543, `?pgbouncer=true`.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: SESSION pooler. Same host and username as above, port 5432.
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# For contrast, this is the "Direct connection" string you should NOT put in
# DIRECT_URL when deploying to Vercel. Different host, plain `postgres`
# username, IPv6-only on the free tier:
#   postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------
# Project Settings > API. Both are public, browser-side values (the anon key is
# safe to expose - it is constrained by row level security).
# Used by lib/supabase.ts, lib/supabase-server.ts and proxy.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key. Project Settings > API, under "service_role".
#
# SECRET. This key bypasses row level security and can create and delete auth
# users, so it must never be exposed to the browser. It has no NEXT_PUBLIC_
# prefix for exactly that reason. Used only by lib/supabase-admin.ts.
#
# Required for the one-click demo on the landing page (/api/demo/login), which
# creates a throwaway auth user per visitor. Without it that endpoint returns
# 503 and the rest of the app is unaffected.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# Stripe (TEST MODE ONLY)
# -----------------------------------------------------------------------------
# Used for Stripe Identity (KYC) and Stripe Issuing (virtual cards).
# Developers > API keys. The secret key must start with `sk_test_`.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Webhook signing secrets.
#
# LOCAL DEVELOPMENT: `stripe listen` prints one account-wide `whsec_...` secret
# that is valid for everything it forwards, so setting STRIPE_WEBHOOK_SECRET
# alone is enough.
#
# DEPLOYED: Stripe mints a DIFFERENT signing secret for every endpoint you
# register under Developers > Webhooks. There are two endpoints here, so you
# need both of the per-endpoint variables below. Each handler prefers its own
# secret and falls back to STRIPE_WEBHOOK_SECRET, which is what makes the local
# single-secret setup work.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-cli-webhook-secret
# Optional locally, required once deployed.
#   /api/webhooks/stripe-identity
STRIPE_IDENTITY_WEBHOOK_SECRET=
#   /api/webhooks/stripe-issuing
STRIPE_ISSUING_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Plaid (SANDBOX ONLY)
# -----------------------------------------------------------------------------
# Dashboard > Developers > Keys. Use the *sandbox* secret, not development or
# production.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret

# sandbox | development | production. Keep this on `sandbox`.
# Anything other than `production` also flips the app into simulated-ACH mode
# (lib/transfer-utils.ts), where transfers settle instantly and locally.
PLAID_ENV=sandbox

# Note: /api/webhooks/plaid verifies Plaid's ES256 JWT signature (the
# `Plaid-Verification` header) and needs no extra secret. The public keys are
# fetched from Plaid at runtime using PLAID_CLIENT_ID and PLAID_SECRET above.


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL of this app. Used to build the Stripe Identity return URL and
# the Plaid webhook URL, so it must be reachable by those services when you are
# testing webhooks (use your tunnel URL, not localhost, in that case).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NODE_ENV is not listed here on purpose. Next.js sets it for you -
# `development` for `next dev`, `production` for `next build` / `next start` -
# and setting it in .env has no effect.


# -----------------------------------------------------------------------------
# Cron (Supabase keep-alive)
# -----------------------------------------------------------------------------
# Guards GET /api/cron/keepalive, the daily job declared in vercel.json. That
# job runs a query against Postgres so Supabase does not pause the free-tier
# project after 7 days of inactivity, which is the usual reason a deployed
# portfolio demo is dead by the time someone clicks the link.
#
# Set CRON_SECRET as a project environment variable on Vercel and Vercel sends
# it automatically on every cron invocation as `Authorization: Bearer <secret>`.
# There is nothing to wire up by hand.
#
# The route FAILS CLOSED: with CRON_SECRET unset it answers 401 to everyone,
# Vercel included, rather than leaving an unauthenticated endpoint that opens a
# database connection on every request.
#
# Generate one with:
#
#   openssl rand -hex 32
#
# Optional locally (the keep-alive only matters for a deployed project);
# required on Vercel.
CRON_SECRET=


# -----------------------------------------------------------------------------
# Transfer limits (optional)
# -----------------------------------------------------------------------------
# All three are read in lib/transfer-utils.ts and fall back to the values shown
# if unset. Amounts are in whole USD.
# Per-transaction limit.
MAX_TRANSFER_AMOUNT=10000
# Rolling daily total per user.
DAILY_TRANSFER_LIMIT=25000
# Transfers above this amount are flagged for review instead of settling
# immediately.
PENDING_REVIEW_THRESHOLD=5000


# -----------------------------------------------------------------------------
# Testing (optional, and deliberately left unset)
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL points the suite at a real Postgres instead of the in-memory
# PGlite database it falls back to (tests/setup.ts). CI sets it; you almost
# certainly do not want it in a local `.env`, because the suite truncates every
# table it touches. Uncomment only against a throwaway database.
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neobank_test
